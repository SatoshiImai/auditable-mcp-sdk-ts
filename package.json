{
  "name": "auditable-mcp-sdk",
  "version": "0.1.1",
  "description": "Auditable MCP SDK — a protocol machine for tool self-attestation into a tamper-evident host ledger (auditable-mcp/0.1.1).",
  "type": "module",
  "license": "MIT",
  "author": "Satoshi Imai",
  "keywords": [
    "mcp",
    "audit",
    "tamper-evident",
    "ledger",
    "rfc8785",
    "ed25519"
  ],
  "engines": {
    "node": ">=20"
  },
  "volta": {
    "node": "24.14.1"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./noble": {
      "types": "./dist/crypto/noble.d.ts",
      "import": "./dist/crypto/noble.js"
    },
    "./aws-kms": {
      "types": "./dist/l2/adapters/aws-kms.d.ts",
      "import": "./dist/l2/adapters/aws-kms.js"
    }
  },
  "files": [
    "dist",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && tsc --noEmit",
    "format": "biome check --write .",
    "spec:check": "tsx scripts/sync-spec.ts --check",
    "spec:sync": "tsx scripts/sync-spec.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "canonicalize": "3.0.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@aws-sdk/client-kms": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-kms": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.8",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
